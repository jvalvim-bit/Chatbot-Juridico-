# Copie este arquivo para .env somente em desenvolvimento.
# Nunca faça commit do arquivo .env preenchido.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Integrações reais não fazem parte desta demonstração.
# Configure-as apenas em um backend privado e use RLS no banco.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AI_API_KEY=
WHATSAPP_SESSION_PATH=
